  constructor(x = 0) { this.x = x; this.v = 0; }
  passo(alvo, dt, w, z) {
    const h = Math.min(dt, 1 / 30) / 2;
    for (let i = 0; i < 2; i++) { this.v += (w * w * (alvo - this.x) - 2 * z * w * this.v) * h; this.x += this.v * h; }
    return this.x;
