  gpu.queue.writeBuffer(bufR1, 0, new Float32Array([2.4, 0, 0, 0]));
  gpu.queue.writeBuffer(bufR2, 0, new Float32Array([6.5, 0, 0, 0]));
  const grupo = (a, b = preto, c = preto, u = bufP) => gpu.createBindGroup({ layout: pl, entries: [
    { binding: 0, resource: a.createView() }, { binding: 1, resource: b.createView() }, { binding: 2, resource: c.createView() },
    { binding: 3, resource: amL }, { binding: 4, resource: { buffer: u } },
  ] });
  const gClaro = grupo(texHDR);
  const gDesce = mipTex.slice(0, -1).map(t => grupo(t));
  const gSobe = mipTex.map((t, i) => (i === NIVEIS - 1 ? null : grupo(i === NIVEIS - 2 ? mipTex[NIVEIS - 1] : texSobe[i + 1], t)));
  const gR1 = grupo(mipTex[2], preto, preto, bufR1), gR2 = grupo(texR1, preto, preto, bufR2);
  const gFinal = grupo(texHDR, texSobe[0], texR2);
  const passar = (enc, p, g, alvo) => {
    const r = enc.beginRenderPass({ colorAttachments: [{ view: alvo.createView(), loadOp: 'clear', storeOp: 'store', clearValue: [0, 0, 0, 1] }] });
    r.setPipeline(p); r.setBindGroup(0, g); r.draw(3); r.end();
  };

  // ---------- movimento ----------
  let fila = [], atual = null;
  const proximo = () => {
    if (TESTE && TESTE.fig) return TESTE.fig;
    if (!fila.length) {
      fila = ELENCO.slice().sort(() => Math.random() - 0.5);
      if (fila[0] === atual) fila.push(fila.shift());
    }
    return fila.shift();
  };
  atual = proximo();
  // poses em que ele para e respira; entre uma e outra, a curva acelera e freia devagar
  const POSES = [-0.62, 0.34, -0.2, 0.7, -0.44, 0.12];
  let pose = 0, tPose = 0, tTroca = 0, trocando = -1, deOnde = POSES[0];
  const DUR_POSE = 3.1, GIRO = 1.45;
  const molaYaw = new Mola(POSES[0]), molaIncl = new Mola(0);
  let presenca = 0, tempo = 0, ultimo = performance.now();
  let nivel = 0, topo = 0.5, vale = 0.2, risco = -2, clarao = 0, fase = Math.random() * 10;

  function nivelSom(dt) {
    if (TESTE && TESTE.nivel !== undefined) return TESTE.nivel;
    const fonte = REACOES.led.personagemSom || 'grave';
    if (fonte === 'desligado' || !audioVivo() || !(A.rmsDb > REACOES.som.piso)) return 0;
    const v = fonte === 'medio' ? A.medio : fonte === 'agudo' ? A.agudo : fonte === 'volume' ? (A.grave + A.medio + A.agudo) / 3 : A.grave;
    topo = Math.max(v, topo - dt * 0.06);
    vale = Math.min(v, vale + dt * 0.06);
    return clamp((v - vale) / Math.max(topo - vale, 0.18));
  }

  function quadro(agora) {
    const dt = TESTE && TESTE.dt ? TESTE.dt : Math.min((agora - ultimo) / 1000, 1 / 20);
    ultimo = agora;
    tempo += dt;
    const quer = ligado();
    presenca = clamp(presenca + (quer ? dt / 1.1 : -dt / 0.8));
    if (presenca <= 0 && !quer) {
      if (tela.style.visibility !== 'hidden') { tela.style.visibility = 'hidden'; teto.style.opacity = 0; }
      requestAnimationFrame(quadro);
      return;
    }
    if (tela.style.visibility === 'hidden') tela.style.visibility = 'visible';
    const alvoNivel = nivelSom(dt);
    nivel += (alvoNivel - nivel) * (1 - Math.exp(-dt * (alvoNivel > nivel ? 24 : 5)));

    // virando de pose em pose
    tPose += dt;
    if (tPose >= DUR_POSE) { tPose -= DUR_POSE; deOnde = POSES[pose]; pose = (pose + 1) % POSES.length; risco = -0.25; }
    let yawAlvo = deOnde + (POSES[pose] - deOnde) * inOutQuint(clamp(tPose / (DUR_POSE * 0.72)));
    tTroca += dt;
    // a troca: acelera até ficar de perfil, troca no meio do clarão, e o novo chega freando
    if (trocando < 0 && tTroca >= segundos() && !(TESTE && TESTE.semTroca)) { trocando = 0; deOnde = POSES[pose]; }
    let esc = 1;
    if (trocando >= 0) {
      trocando += dt / GIRO;
      if (trocando < 0.5) {
        const k = inCubic(trocando * 2);
        yawAlvo = molaYaw.x * 0 + deOnde + (Math.PI / 2 - deOnde) * k;
        esc = 1 - 0.03 * k;
        clarao = Math.max(clarao, k * k);
      } else {
        if (trocando - dt / GIRO < 0.5) { atual = proximo(); molaYaw.x = -Math.PI / 2; molaYaw.v = 0; risco = -0.3; }
        const k = outQuint((trocando - 0.5) * 2);
        yawAlvo = -Math.PI / 2 + (POSES[pose] + Math.PI / 2) * k;
        esc = 0.97 + 0.03 * outBack(clamp((trocando - 0.5) * 2));
      }
      if (trocando >= 1) { trocando = -1; tTroca = 0; tPose = DUR_POSE * 0.72; deOnde = POSES[pose]; }
    }
    // durante a troca a mola quase não atrasa, senão o corpo não passaria de perfil na hora do clarão
    const yaw = trocando >= 0 ? molaYaw.passo(yawAlvo, dt, 40, 1) : molaYaw.passo(yawAlvo, dt, 7, 0.82);
    fase += dt;
    const incl = molaIncl.passo(molaYaw.v * -0.012, dt, 5, 0.7);
    const pitch = -0.03 + Math.sin(fase * 0.43) * 0.022;
    const roll = incl + Math.sin(fase * 0.31 + 1) * 0.012;
    const yawFinal = TESTE && TESTE.yaw !== undefined ? TESTE.yaw : yaw;
    risco += dt * 0.62;
    clarao *= Math.exp(-dt * 5.5);
    const entra = inOutQuint(presenca);

    const f = FIG[atual];
    const cy_ = Math.cos(yawFinal), sy = Math.sin(yawFinal), cp = Math.cos(pitch), sp = Math.sin(pitch), cr = Math.cos(roll), sr = Math.sin(roll);
    // R = roll * pitch * yaw, por colunas
    const R = [
      cr * cy_ + sr * sp * sy, sr * cp, -cr * sy + sr * sp * cy_, 0,
      -sr * cy_ + cr * sp * sy, cr * cp, sr * sy + cr * sp * cy_, 0,
      cp * sy, -sp, cp * cy_, 0,
    ];
    const respira = Math.sin(fase * 0.9) * 0.008;
    const E = { a: -1, b: -1, i: -1 }[atual] || 1;
    fU.set(VP, 0);
    fU.set(R, 16);
    fU.set([0, PE + respira + (1 - entra) * -0.1, Z_FIG, ALTURA], 28);
    fU.set([tempo, nivel, clarao * 1.0, risco], 32);
    fU.set([LETRAS.indexOf(atual), E, f.largura, esc * (0.92 + 0.08 * entra)], 36);
    gpu.queue.writeBuffer(bufU, 0, fU);
    const lt = querAtras() ? window.__logoTela : null;
    gpu.queue.writeBuffer(bufLogo, 0, new Float32Array(lt ? [lt.cx, lt.cy, lt.z, lt.meia, lt.prof ?? 0.16, lt.a, lt.b, lt.m, lt.xc ?? 0, lt.yc ?? HT - 0.64, 0, 0] : new Array(12).fill(0)));
    gpu.queue.writeBuffer(bufP, 0, new Float32Array([0, 0.5 + 0.95 * nivel + clarao * 2.6, 0.22 + 0.5 * nivel + clarao * 1.6, entra]));
    teto.style.opacity = (entra * (0.06 + 0.2 * nivel + 0.7 * clarao)).toFixed(3);

    const enc = gpu.createCommandEncoder();
    const r = enc.beginRenderPass({
      colorAttachments: [{ view: texMS.createView(), resolveTarget: texHDR.createView(), loadOp: 'clear', storeOp: 'discard', clearValue: [0, 0, 0, 0] }],
      depthStencilAttachment: { view: texProf.createView(), depthClearValue: 0, depthLoadOp: 'clear', depthStoreOp: 'discard' },
    });
    r.setPipeline(pCorpo); r.setBindGroup(0, bgCorpo); r.setVertexBuffer(0, bufV); r.setIndexBuffer(bufI, 'uint32');
    r.drawIndexed(f.n, 1, f.primeiro, f.baseV);
    r.end();
    passar(enc, pClaro, gClaro, mipTex[0]);
    for (let i = 0; i < NIVEIS - 1; i++) passar(enc, pDesce, gDesce[i], mipTex[i + 1]);
    for (let i = NIVEIS - 2; i >= 0; i--) passar(enc, pSobe, gSobe[i], texSobe[i]);
    passar(enc, pRastro, gR1, texR1);
    passar(enc, pRastro, gR2, texR2);
    const fim = enc.beginRenderPass({ colorAttachments: [{ view: contexto.getCurrentTexture().createView(), loadOp: 'clear', storeOp: 'store', clearValue: [0, 0, 0, 0] }] });
    fim.setPipeline(pFinal); fim.setBindGroup(0, gFinal); fim.setBindGroup(1, gLogo); fim.draw(3); fim.end();
    gpu.queue.submit([enc.finish()]);
    window.__personagens = { atual, yaw: +yawFinal.toFixed(2), nivel: +nivel.toFixed(2), presenca: +presenca.toFixed(2), trocando: +trocando.toFixed(2) };
    requestAnimationFrame(quadro);
  }
  requestAnimationFrame(t => { ultimo = t; quadro(t); });
  return { quadro };
}
